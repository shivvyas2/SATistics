# SATistics backend environment.
# Copy to backend/.env and fill in. Never commit the real file.
# Full guide: docs/handbook (chapter 3, "Running it locally").

# --- Supabase (required) ---------------------------------------------------
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-only key that bypasses Row Level Security. Never expose it to a browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Older names, still read as fallbacks. You can leave them unset.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key
# Last-resort fallback if no service-role key is set. With only the anon key,
# Row Level Security blocks the backend's writes, so set the service-role key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- CORS (required in production) -----------------------------------------
# Comma-separated origins allowed to call the API. localhost:3000/3001 are always allowed.
ALLOWED_ORIGINS=http://localhost:3000

# --- AI questions (optional) -----------------------------------------------
# Without a key, SAT questions still come from the College Board question bank,
# GRE questions use the built-in offline bank, and uploaded material can't be parsed.
# Claude through the Anthropic API. Used instead of OpenRouter when set.
# Create a key on the API keys page of the Claude Console.
ANTHROPIC_API_KEY=
# Model that writes questions. Defaults to claude-opus-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5
# Or any model through OpenRouter: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Defaults to anthropic/claude-haiku-4.5.
# OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# Model that re-solves AI-written questions blind to check their answer keys. A different
# model than the writer makes the check independent. Defaults to claude-sonnet-5-5 with
# ANTHROPIC_API_KEY, and to OPENROUTER_MODEL with OpenRouter.
# VERIFIER_MODEL=

# --- Lesson videos (optional) ----------------------------------------------
# Tried in this order: YouTube Data API, Serper, then DuckDuckGo (no key, rate limited).
# YouTube: Google Cloud Console -> enable "YouTube Data API v3" -> create an API key.
YOUTUBE_API_KEY=
# Serper: https://serper.dev
SERPER_API_KEY=
